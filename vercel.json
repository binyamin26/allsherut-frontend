{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/services/traiteur", "destination": "/fr/services/traiteur", "permanent": true },
    { "source": "/services/activites-sportives", "destination": "/fr/services/activites-sportives", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://homesherut-backend.fly.dev/api/:path*"
    },
    {
      "source": "/sitemap-providers.xml",
      "destination": "https://homesherut-backend.fly.dev/sitemap-providers.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
